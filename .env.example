# DarkGreen SIEM - example environment (copy to .env and rotate all secrets)

DATABASE_URL=postgresql+psycopg://siem:CHANGE_ME@localhost:5432/darkgreen_siem

# Auth
# Outside a private lab: rotate AUTH_SECRET / SIEM_API_TOKEN / DEMO_PASSWORD /
# SYSLOG_SHARED_SECRET / DATABASE_URL password and set STRICT_SECRETS=true.
# STRICT_SECRETS also rejects weak DEMO_PASSWORD, SYSLOG secret, and DB password.
AUTH_ENABLED=true
ALLOW_INSECURE_NO_AUTH=false
STRICT_SECRETS=false
DISABLE_OPENAPI=false
AUTH_SECRET=change-me-long-random-string
SIEM_API_TOKEN=change-me-machine-token
DEMO_USERNAME=analyst
DEMO_PASSWORD=change-me-demo-password
# Only enable behind a trusted reverse proxy that sets X-Real-IP / X-Forwarded-For.
TRUST_X_FORWARDED_FOR=false

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Syslog UDP (compose default secret; rotate outside lab)
SYSLOG_HOST=0.0.0.0
SYSLOG_PORT=5140
SYSLOG_SHARED_SECRET=dg-lab-syslog

# Lean ops (lab)
# Default compose is lean (no log-generator). Demo traffic:
#   docker compose --profile demo up --build
RETENTION_DAYS=7
HEALTH_STALE_MINUTES=5
HEALTH_SILENT_MINUTES=30
PURGE_INTERVAL_SEC=300
RULE_INTERVAL_SEC=30
INTERVAL_SEC=8
SEED_ON_START=true
RUN_BACKGROUND_JOBS=true

# Egress SSRF controls (notify / LLM)
ALLOW_INSECURE_WEBHOOKS=false
EGRESS_HOST_ALLOWLIST=
# Example allowlist: hooks.slack.com,api.openai.com

# Optional enrichment / notify / LLM
VT_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=
NOTIFY_WEBHOOK_URL=
NOTIFY_FORMAT=slack
NOTIFY_MIN_SEVERITY=high
LLM_ENABLED=false
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

DEFAULT_TENANT_ID=lab
DEFAULT_TENANT_NAME=Lab
